PORT=5000
# Update these credentials matching your local specific postgres setup if needed
DATABASE_URL=postgres://your_username:your_password@localhost:5432/autobi
JWT_SECRET=your_jwt_secret_here

# --- Firebase Admin SDK Credentials ---
# You can get these by generating a new private key from your Firebase Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"


# --- SMTP Email Configuration ---
# Gmail requires an "App Password" to be generated if 2FA is enabled.
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
